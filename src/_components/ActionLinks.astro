---
import WhatsappIcon from './WhatsappIcon.astro';
import { offersLink, salesLink, site, supportLink } from '../_data/site';

const external = {
  target: '_blank',
  rel: 'noopener noreferrer',
};
---

<section class="actions" aria-label="Atalhos de atendimento">
  {
    salesLink ? (
      <a class="sales" href={salesLink} {...external}>
        <span class="sales-inner">
          <span class="scan-line" aria-hidden="true" />
          <span class="icon icon-whatsapp"><WhatsappIcon /></span>
          <span class="copy">
            <span class="eyebrow">{site.salesEyebrow}</span>
            <span class="sales-title">{site.salesTitle}</span>
          </span>
          <span class="chevron chevron-light" aria-hidden="true">›</span>
        </span>
      </a>
    ) : (
      <div class="sales">
        <span class="sales-inner">
          <span class="scan-line" aria-hidden="true" />
          <span class="icon icon-whatsapp"><WhatsappIcon /></span>
          <span class="copy">
            <span class="eyebrow">{site.salesEyebrow}</span>
            <span class="sales-title">{site.salesTitle}</span>
          </span>
          <span class="chevron chevron-light" aria-hidden="true">›</span>
        </span>
      </div>
    )
  }

  {
    supportLink ? (
      <a class="card" href={supportLink} {...external}>
        <span class="icon icon-blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
        </span>
        <span class="copy">
          <span class="card-title">{site.supportTitle}</span>
          <span class="card-sub">{site.supportSubtitle}</span>
        </span>
        <span class="chevron" aria-hidden="true">›</span>
      </a>
    ) : (
      <div class="card">
        <span class="icon icon-blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
        </span>
        <span class="copy">
          <span class="card-title">{site.supportTitle}</span>
          <span class="card-sub">{site.supportSubtitle}</span>
        </span>
        <span class="chevron" aria-hidden="true">›</span>
      </div>
    )
  }

  {
    offersLink ? (
      <a class="card card-offers" href={offersLink} {...external}>
        <span class="icon icon-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
          </svg>
        </span>
        <span class="copy">
          <span class="card-title">{site.offersTitle}</span>
          <span class="card-sub">{site.offersSubtitle}</span>
        </span>
        <svg class="ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
        </svg>
      </a>
    ) : (
      <div class="card card-offers">
        <span class="icon icon-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
          </svg>
        </span>
        <span class="copy">
          <span class="card-title">{site.offersTitle}</span>
          <span class="card-sub">{site.offersSubtitle}</span>
        </span>
        <svg class="ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
        </svg>
      </div>
    )
  }
</section>

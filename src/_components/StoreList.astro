---
import { site } from '../_data/site';
---

<section class="stores" aria-labelledby="stores-title">
  <div class="section-heading">
    <span aria-hidden="true"></span>
    <h2 id="stores-title">{site.storesTitle}</h2>
    <span aria-hidden="true"></span>
  </div>
  <div class="store-list">
    {
      site.stores.map((store) => (
        <article class="store">
          <img class="crest" src={store.crest} alt={store.crestAlt} width="64" height="64" />
          <span class="store-copy">
            <span class="store-title">{store.title}</span>
            <span class="store-address">{store.address}</span>
            {store.cep && <span class="store-cep">CEP: {store.cep}</span>}
          </span>
        </article>
      ))
    }
  </div>
</section>

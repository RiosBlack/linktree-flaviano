---
import { findPublicImage } from '../_data/images';

interface Props {
  name: string;
  alt: string;
  label: string;
  hint: string;
  priority?: boolean;
}

const { name, alt, label, hint, priority = false } = Astro.props;
const src = findPublicImage(name);
---

{
  src ? (
    <img
      class="slot-image"
      src={src}
      alt={alt}
      decoding="async"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  ) : (
    <div class="slot-placeholder" role="img" aria-label={`${label}. ${hint}`}>
      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="9" cy="10" r="1.4" fill="currentColor" stroke="none" />
        <path d="M21 16l-5-5-9 9" />
      </svg>
      <strong>{label}</strong>
      <span>{hint}</span>
    </div>
  )
}
